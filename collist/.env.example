# ColList environment variables.
# Copy to .env.local and fill in. .env.local is gitignored; never commit a real key.
#
#   cp .env.example .env.local
#
# Next.js reads .env.local only at startup — restart the dev server after editing.

# Google Gemini API key. Free tier: https://aistudio.google.com/apikey
# OPTIONAL. Without it the AI Vibe Check runs entirely on the local fallback
# engine (data/qualitativeData.json) and the modal shows "Offline culture
# profile". Every feature works either way; nothing errors.
GEMINI_API_KEY=

# Model id used by /api/vibe-check. Defaults to gemini-3.6-flash.
# Override when Google retires a model — they do so without notice, and a
# retired id returns 404, which silently falls back to the offline engine.
# List the ids your key can reach:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" \
#     | grep '"name"'
# Note: the route calls the v1 surface, not v1beta — current models 404 on v1beta.
GEMINI_MODEL=
